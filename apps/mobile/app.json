{
  "expo": {
    "name": "Real Life Overall",
    "slug": "real-life-overall",
    "version": "0.1.0",
    "platforms": ["ios"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rlo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07090d",
    "ios": {
      "bundleIdentifier": "com.psc3245.realifeoverall",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07090d",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
